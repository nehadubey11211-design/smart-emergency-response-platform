# FILE: backend/.env
# ==========================
# Backend Environment Variables
# ==========================
#
# ⚠️  IMPORTANT: This file contains secrets.
#    It is listed in .gitignore — NEVER commit it to version control.
#    Each developer and each deployment environment has their own copy.
#
# The settings.py module reads these values using pydantic-settings.
# If a required variable is missing, the app fails to start with a clear error.
#
# GENERATING A SECRET KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# DOCKER COMPOSE:
#   When using docker-compose.yml, values here are overridden by the
#   `environment:` section in docker-compose.yml for the backend service.

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker Compose: HOST = "db" (the service name, not localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergency_db

# ─── JWT Authentication ───────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-replace-before-deploying-to-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AI Model ─────────────────────────────────────────────────────────────────
MODEL_PATH=../ai-module/model/accident_model.h5
CONFIDENCE_THRESHOLD=0.75

# ─── Email Notifications (SMTP) ───────────────────────────────────────────────
# Leave blank to disable email alerts during development.
# For Gmail: enable "App Passwords" in your Google Account security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
