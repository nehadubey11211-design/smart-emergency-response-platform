# FILE: backend/.env.example
# ======================================
# Environment Variables Template
# ======================================
#
# HOW TO USE THIS FILE:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in your actual values below
#   3. NEVER commit .env to git (it's in .gitignore)
#
# This file (.env.example) IS safe to commit — it contains
# placeholder values only, no real secrets.
#
# ──────────────────────────────────────────────────────────────────────────────
# NEON DATABASE SETUP INSTRUCTIONS
# ──────────────────────────────────────────────────────────────────────────────
#
# Step 1: Go to https://neon.tech
# Step 2: Sign up for a free account (no credit card required)
# Step 3: Click "Create Project"
#         - Project name: smart-ai-emergency-response (or anything you like)
#         - Database name: emergency_db
#         - Region: choose the closest to you
# Step 4: After creation, go to "Connection Details" in the dashboard
# Step 5: Select "Connection string" from the dropdown
# Step 6: Copy the full connection string — it looks like:
#           postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Step 7: Paste it as the value of DATABASE_URL below
#
# IMPORTANT: The connection string MUST end with ?sslmode=require
# If you copy it from Neon dashboard it will already include this.
#
# ──────────────────────────────────────────────────────────────────────────────
# RUNNING SCHEMA ON NEON
# ──────────────────────────────────────────────────────────────────────────────
#
# After setting DATABASE_URL, run the schema and seed:
#
# Option A — Using psql (if installed):
#   psql "your-neon-connection-string" -f database/schema.sql
#   psql "your-neon-connection-string" -f database/seed.sql
#
# Option B — Using Neon's SQL Editor:
#   Go to your Neon dashboard → SQL Editor
#   Paste and run the contents of database/schema.sql
#   Then paste and run database/seed.sql
#
# Option C — Using FastAPI's create_all (automatic):
#   Just start the backend — SQLAlchemy will create tables automatically
#   via Base.metadata.create_all() in main.py's lifespan handler.
#   Note: This won't load seed data — do that manually if needed.
#
# ──────────────────────────────────────────────────────────────────────────────


# ─── Database (REQUIRED — replace with your Neon connection string) ───────────
#
# NEON FORMAT:
#   postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
#
# The ?sslmode=require at the end is MANDATORY for Neon.
#
DATABASE_URL=postgresql://your_user:your_password@ep-your-endpoint.region.aws.neon.tech/your_dbname?sslmode=require

# ─── JWT Authentication ───────────────────────────────────────────────────────
#
# Generate a secure secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
SECRET_KEY=your-super-secret-key-change-this-in-production-generate-with-python

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Application ─────────────────────────────────────────────────────────────
#
# Set to false in production to disable hot-reload and verbose errors
#
DEBUG=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
#
# Comma-separated list of allowed origins.
# In production, replace with your actual frontend domain.
#
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Email Notifications (optional) ──────────────────────────────────────────
#
# Leave SMTP_USER empty to disable email notifications.
# For Gmail: use an App Password (not your regular Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── AI Module ────────────────────────────────────────────────────────────────
MODEL_PATH=../ai-module/model/accident_model.h5
CONFIDENCE_THRESHOLD=0.75
