# FILE: backend/.env.example
# ======================================
# Environment Variables Template
# ======================================
#
# HOW TO USE THIS FILE:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in your actual values below
#   3. NEVER commit .env to git (it's in .gitignore)
#
# This file (.env.example) IS safe to commit — it contains
# placeholder values only, no real secrets.
# ──────────────────────────────────────────────────────────────────────────────
#
#
# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname
# Do NOT add ?sslmode=require — SSL is handled in db.py via connect_args
DATABASE_URL=postgresql+asyncpg://your_user:your_password@ep-your-endpoint.region.aws.neon.tech/your_dbname

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Email (optional — leave blank to disable) ────────────────────────────────
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Module ────────────────────────────────────────────────────────────────
MODEL_PATH=../ai-module/model/accident_model.h5
CONFIDENCE_THRESHOLD=0.85
